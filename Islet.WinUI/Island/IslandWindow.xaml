<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="Islet.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    Title="islet">

    <!-- The window itself is fully transparent (TransparentTintBackdrop, set in code):
         only the pill is drawn, and everything outside it lets clicks through. -->
    <Grid x:Name="Root" Background="Transparent">

        <Grid x:Name="Pill" Width="260" Height="44" Margin="24,8,24,0"
              HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="22">
            <!-- Real blur of whatever is behind the island; Black theme turns it off. -->
            <SystemBackdropElement x:Name="Blur" CornerRadius="22" />
            <Border x:Name="Tint" CornerRadius="22" BorderThickness="1" />

            <!-- COLLAPSED. Laid out at 260x44 and scaled as a whole by the pill size setting. -->
            <Viewbox Stretch="Uniform">
                <Grid x:Name="Compact" Width="260" Height="44" Padding="8,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="4" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Album art, or a music note while there is none. -->
                    <Border Grid.Row="1" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <FontIcon x:Name="ArtPlaceholder" Glyph="&#xEC4F;" FontSize="13"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border CornerRadius="14">
                                <Border.Background>
                                    <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Title marquee. TitleSource holds the real text (hidden by a clip while it scrolls);
                         FadeHost shows it again through a gradient mask so the edges fade. -->
                    <Grid x:Name="TitleViewport" Grid.Row="1" Grid.Column="2" Height="20" VerticalAlignment="Center">
                        <Grid x:Name="TitleSourceClip">
                            <StackPanel x:Name="TitleSource" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="NoWrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="FadeHost" IsHitTestVisible="False" />
                    </Grid>

                    <!-- Equalizer: bars grow from the bottom; animated on the composition thread. -->
                    <StackPanel x:Name="EqualizerBars" Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="1.5"
                                Height="16" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Rectangle Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" />
                        <Rectangle Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" />
                        <Rectangle Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" />
                        <Rectangle Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" />
                    </StackPanel>

                    <!-- Thin progress line: the fill is scaled by a composition animation, not by a timer. -->
                    <Grid x:Name="ProgressTrack" Grid.Row="2" Grid.ColumnSpan="5" Margin="14,0,0,0">
                        <Rectangle Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource ControlFillColorDefaultBrush}" />
                        <Rectangle x:Name="ProgressFill" Height="2" RadiusX="1" RadiusY="1" />
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</winex:WindowEx>
