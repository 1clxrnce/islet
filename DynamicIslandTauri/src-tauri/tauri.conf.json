{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dynamic Island Music",
  "version": "0.1.0",
  "identifier": "com.local.dynamicisland.music",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dynamic Island Music",
        "width": 560,
        "height": 240,
        "minWidth": 560,
        "maxWidth": 560,
        "minHeight": 240,
        "maxHeight": 240,
        "resizable": false,
        "center": false,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
