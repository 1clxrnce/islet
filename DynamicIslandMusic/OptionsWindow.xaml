<Window x:Class="DynamicIslandMusic.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="islet options"
        Width="372" Height="446"
        Background="#141416"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E98" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E98" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8EC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8E8EC" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#3A3A46" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#3A3A46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboSurface" Background="#222226" BorderBrush="#3A3A42"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <ContentPresenter Margin="8,0,26,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <ToggleButton x:Name="ComboToggle" Width="24" HorizontalAlignment="Right"
                                                  Focusable="False" ClickMode="Press" Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#C8C8D0" StrokeThickness="1.5"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </ToggleButton>
                                    <Popup x:Name="PART_Popup" Placement="Bottom" PopupAnimation="Slide"
                                           IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                           Focusable="False">
                                        <Border Background="#222226" BorderBrush="#3A3A42" BorderThickness="1"
                                                MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                            <ScrollViewer><ItemsPresenter /></ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboSurface" Property="Background" Value="#2C2C33" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18,20,18">
        <TextBlock Text="islet options" FontFamily="Segoe UI Variable Display, Segoe UI"
                   FontSize="18" FontWeight="SemiBold" Foreground="#F5F5F7" />

        <TextBlock Style="{StaticResource Label}" Text="MEDIA SOURCE" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceCombo" Style="{StaticResource DarkCombo}" Height="30"
                      DisplayMemberPath="Name" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                      Background="#222226" Foreground="#E8E8EC" />
            <Button Grid.Column="1" Content="Refresh" Width="74" Height="30" Margin="8,0,0,0"
                    Click="RefreshSources_Click" FontFamily="Segoe UI Variable Text, Segoe UI"
                    FontSize="11" Foreground="#E8E8EC" Background="#26262B" BorderThickness="0" Cursor="Hand" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Text="Automatic follows the app that is playing. Pick a name to pin it." />

        <TextBlock Style="{StaticResource Label}" Text="DISPLAY" />
        <ComboBox x:Name="MonitorCombo" Style="{StaticResource DarkCombo}" Height="30"
                  FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                  Background="#222226" Foreground="#E8E8EC" />

        <CheckBox x:Name="AutoHideCheck" Style="{StaticResource Toggle}" Content="Slide away when nothing is playing" />
        <CheckBox x:Name="DodgeCheck" Style="{StaticResource Toggle}" Content="Dodge the cursor when it reaches the island" />

        <TextBlock Style="{StaticResource Label}" Text="CONTROLS" />
        <CheckBox x:Name="HotkeysCheck" Style="{StaticResource Toggle}" Content="Ctrl + Alt + Space / Left / Right" />
        <CheckBox x:Name="StartupCheck" Style="{StaticResource Toggle}" Content="Start with Windows" />

        <TextBlock Style="{StaticResource Hint}" Margin="0,18,0,0"
                   Text="Right-drag the pill to move it. Hold Alt or Ctrl to expand the controller and use its buttons; Ctrl+Alt+E keeps it open. Scroll over the pill to change volume." />

        <Button Content="Done" Width="90" Height="32" HorizontalAlignment="Right" Margin="0,18,0,0"
                Click="Done_Click" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                Foreground="#101012" Background="#E8E8EC" BorderThickness="0" Cursor="Hand" />
    </StackPanel>
</Window>
