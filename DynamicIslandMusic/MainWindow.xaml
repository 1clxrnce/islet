<Window x:Class="DynamicIslandMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="580" Height="240"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded">

    <Window.Resources>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif</FontFamily>

        <LinearGradientBrush x:Key="EdgeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3FFFFFFF" Offset="0" />
            <GradientStop Color="#14FFFFFF" Offset="0.35" />
            <GradientStop Color="#06FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#222228" Offset="0" />
            <GradientStop Color="#101013" Offset="0.55" />
            <GradientStop Color="#08080A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MarqueeMask" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="Transparent" Offset="0" />
            <GradientStop Color="White" Offset="0.12" />
            <GradientStop Color="White" Offset="0.88" />
            <GradientStop Color="Transparent" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="18" Background="Transparent"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.93" Duration="0:0:0.09" />
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.93" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayGlyphStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.3" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.3" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PauseGlyphStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.6" ScaleY="0.6" /></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.6" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.6" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VolumeTrack" TargetType="Grid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ArtPlaceholder" TargetType="TextBlock">
            <Setter Property="Text" Value="♪" />
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#C0C0CA" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="LiveHide" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Shell">
        <Grid x:Name="SlideHost" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform><TranslateTransform x:Name="SlideTransform" Y="-100" /></Grid.RenderTransform>

            <Path x:Name="ShadowWide" Stretch="Fill" Fill="#000000" Opacity="0.28" IsHitTestVisible="False">
                <Path.Effect><BlurEffect Radius="22" /></Path.Effect>
                <Path.RenderTransform><TranslateTransform Y="8" /></Path.RenderTransform>
            </Path>
            <Path x:Name="GlowPath" Stretch="Fill" Fill="{Binding AccentBrush}" Opacity="0.5" IsHitTestVisible="False">
                <Path.Effect><BlurEffect Radius="26" /></Path.Effect>
            </Path>
            <Path x:Name="ShadowPath" Stretch="Fill" Fill="#000000" Opacity="0.5" IsHitTestVisible="False">
                <Path.Effect><BlurEffect Radius="7" /></Path.Effect>
                <Path.RenderTransform><TranslateTransform Y="2" /></Path.RenderTransform>
            </Path>

            <Grid x:Name="Pill" Width="264" Height="44" Margin="0,9,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True"
                                    MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                   MouseRightButtonDown="Pill_MouseRightDown" MouseMove="Pill_MouseRightMove"
                   MouseRightButtonUp="Pill_MouseRightUp" MouseWheel="Pill_MouseWheel">
                <Grid.Clip>
                    <RectangleGeometry x:Name="PillClip" Rect="0,0,264,44" RadiusX="22" RadiusY="22" />
                </Grid.Clip>

                <Path x:Name="BodyPath" Stretch="Fill" Fill="{StaticResource BodyBrush}" IsHitTestVisible="False" />
                <Path x:Name="EdgePath" Stretch="Fill" Fill="Transparent" Stroke="{StaticResource EdgeBrush}"
                      StrokeThickness="1" IsHitTestVisible="False" />

                <!-- MINI -->
                <Grid x:Name="CompactRoot" Margin="12,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="2" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="28" Height="28" CornerRadius="9" Background="#202024" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Style="{StaticResource ArtPlaceholder}" FontSize="12" />
                            <Border CornerRadius="9">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2" Height="20" VerticalAlignment="Center" ClipToBounds="True"
                          OpacityMask="{StaticResource MarqueeMask}">
                        <TextBlock x:Name="CompactTitle" Text="{Binding Title}" FontFamily="{StaticResource UiFont}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="CompactTitleTranslate" X="0" /></TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>

                    <Grid x:Name="CompactProgressTrack" Grid.Row="1" Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom">
                        <Border Height="2" CornerRadius="1" Background="#2AFFFFFF" />
                        <Border x:Name="CompactProgressFill" Height="2" CornerRadius="1" Width="0"
                                HorizontalAlignment="Left" Background="{Binding AccentBrush}" />
                    </Grid>
                </Grid>

                <!-- PEEK / HOVER -->
                <Grid x:Name="PeekRoot" Opacity="0" IsHitTestVisible="False" Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" CornerRadius="10" Background="#202024">
                        <Grid>
                            <TextBlock Style="{StaticResource ArtPlaceholder}" />
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="0">
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource UiFont}" FontSize="14"
                                   FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" FontFamily="{StaticResource UiFont}" FontSize="12"
                                   Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid x:Name="PeekVolumeHost" Width="30" HorizontalAlignment="Left"
                              MouseEnter="VolumeHost_MouseEnter" MouseLeave="VolumeHost_MouseLeave">
                            <Button x:Name="PeekVolumeButton" Style="{StaticResource TransportButton}"
                                    Width="30" Height="30" Click="VolumeButton_Click"
                                    AutomationProperties.Name="Mute or unmute">
                                <TextBlock x:Name="PeekVolumeGlyph" Text="&#xE767;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" Foreground="White" />
                            </Button>
                            <Grid x:Name="PeekVolumePanel" Width="0" HorizontalAlignment="Right" ClipToBounds="True">
                                <Grid x:Name="PeekVolumeTrack" Style="{StaticResource VolumeTrack}" Width="86"
                                      PreviewMouseLeftButtonDown="PeekVolume_Down"
                                      PreviewMouseMove="PeekVolume_Move"
                                      PreviewMouseLeftButtonUp="PeekVolume_Up">
                                    <Border Height="3" CornerRadius="1.5" Background="#3AFFFFFF" VerticalAlignment="Center" />
                                    <Border x:Name="PeekVolumeFill" Height="3" CornerRadius="1.5" Width="0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{Binding AccentBrush}" />
                                </Grid>
                            </Grid>
                        </Grid>
                        <Button Style="{StaticResource TransportButton}" Width="30" Height="30"
                                Command="{Binding PlayPauseCommand}" AutomationProperties.Name="Play or pause">
                            <Grid>
                                <TextBlock x:Name="PeekPlayGlyph" Style="{StaticResource PlayGlyphStyle}" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White" />
                                <TextBlock x:Name="PeekPauseGlyph" Style="{StaticResource PauseGlyphStyle}" Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- EXPANDED -->
                <Grid x:Name="ExpandedRoot" Opacity="0" IsHitTestVisible="False" Margin="34,18,34,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="CoverHost" Width="80" Height="80">
                        <Border x:Name="CoverA" CornerRadius="16" Background="#202024">
                            <Border.RenderTransform><ScaleTransform x:Name="CoverAScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                            <Grid>
                                <TextBlock Style="{StaticResource ArtPlaceholder}" FontSize="24" />
                                <Border x:Name="CoverAArt" CornerRadius="16" />
                            </Grid>
                        </Border>
                        <Border x:Name="CoverB" CornerRadius="16" Background="#202024" Opacity="0">
                            <Border.RenderTransform><ScaleTransform x:Name="CoverBScale" ScaleX="0.9" ScaleY="0.9" /></Border.RenderTransform>
                            <Grid>
                                <TextBlock Style="{StaticResource ArtPlaceholder}" FontSize="24" />
                                <Border x:Name="CoverBArt" CornerRadius="16" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Height="34" ClipToBounds="True" OpacityMask="{StaticResource MarqueeMask}">
                            <StackPanel x:Name="TitleTranslate" VerticalAlignment="Center">
                                <StackPanel.RenderTransform><TranslateTransform x:Name="ExpandedTitleTranslate" Y="0" /></StackPanel.RenderTransform>
                                <TextBlock x:Name="ExpandedTitle" FontFamily="{StaticResource UiFont}" FontSize="15"
                                           FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis">
                                    <TextBlock.RenderTransform><TranslateTransform x:Name="ExpandedTitleMarquee" X="0" /></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="ExpandedArtist" FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SeekBar" Grid.Row="1" Height="18" Margin="0,8,0,0" Background="Transparent"
                              Cursor="Hand" Style="{StaticResource LiveHide}"
                              PreviewMouseLeftButtonDown="SeekBar_Down" PreviewMouseMove="SeekBar_Move"
                              PreviewMouseLeftButtonUp="SeekBar_Up">
                            <Border Height="4" CornerRadius="2" Background="#2AFFFFFF" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Border x:Name="SeekFill" Height="4" CornerRadius="2" Width="0" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Background="{Binding AccentBrush}" IsHitTestVisible="False" />
                            <Grid x:Name="SeekHeadHost" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  IsHitTestVisible="False">
                                <Grid.RenderTransform><TranslateTransform x:Name="SeekHeadTranslate" X="0" /></Grid.RenderTransform>
                                <Ellipse Width="9" Height="9" Fill="Transparent" Stroke="{Binding AccentBrush}" StrokeThickness="1" Opacity="0.7" />
                                <Ellipse Width="5" Height="5" Fill="White" />
                            </Grid>
                            <Border x:Name="SeekTip" Visibility="Collapsed" Background="#E6000000" CornerRadius="4"
                                    Padding="6,3" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,-18,0,0"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="SeekTipText" FontFamily="{StaticResource UiFont}" FontSize="10"
                                           Foreground="White" Typography.NumeralAlignment="Tabular" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <TextBlock x:Name="ElapsedText" Text="{Binding Elapsed}" FontFamily="{StaticResource UiFont}"
                                       FontSize="10" Foreground="#B9B9C0" Typography.NumeralAlignment="Tabular" />
                            <TextBlock x:Name="TotalText" HorizontalAlignment="Right"
                                       Text="{Binding Total}" FontFamily="{StaticResource UiFont}" FontSize="10"
                                       Foreground="#B9B9C0" Typography.NumeralAlignment="Tabular" />
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,6,0,0" Height="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ExpandedVolumeButton" Style="{StaticResource TransportButton}"
                                    Width="26" Height="26" Click="VolumeButton_Click"
                                    AutomationProperties.Name="Mute or unmute">
                                <TextBlock x:Name="ExpandedVolumeGlyph" Text="&#xE767;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" Foreground="White" />
                            </Button>
                            <Grid Grid.Column="1" x:Name="ExpandedVolumeTrack" Style="{StaticResource VolumeTrack}"
                                  Margin="8,0,0,0"
                                  PreviewMouseLeftButtonDown="ExpandedVolume_Down"
                                  PreviewMouseMove="ExpandedVolume_Move"
                                  PreviewMouseLeftButtonUp="ExpandedVolume_Up">
                                <Border Height="3" CornerRadius="1.5" Background="#3AFFFFFF" VerticalAlignment="Center" />
                                <Border x:Name="ExpandedVolumeFill" Height="3" CornerRadius="1.5" Width="0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{Binding AccentBrush}" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButton}" Content="&#xE892;" Command="{Binding PreviousCommand}"
                                IsEnabled="{Binding CanPrevious}" AutomationProperties.Name="Previous track" />
                        <Button Style="{StaticResource TransportButton}" Command="{Binding PlayPauseCommand}"
                                IsEnabled="{Binding CanPlayPause}" AutomationProperties.Name="Play or pause">
                            <Grid>
                                <TextBlock x:Name="ExpandedPlayGlyph" Style="{StaticResource PlayGlyphStyle}" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="White" />
                                <TextBlock x:Name="ExpandedPauseGlyph" Style="{StaticResource PauseGlyphStyle}" Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="White" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource TransportButton}" Content="&#xE893;" Command="{Binding NextCommand}"
                                IsEnabled="{Binding CanNext}" AutomationProperties.Name="Next track" />
                        <Button Style="{StaticResource TransportButton}" Content="&#xE713;" Click="OptionsButton_Click"
                                 AutomationProperties.Name="Options" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
